# ──────────────────────────────────────────────────────────────────────────────
# ClaimTrace – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-32-random-chars
SESSION_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=10

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, dev only)
DATABASE_URL=sqlite:///./claimtrace.db
# PostgreSQL / Azure SQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/claimtrace

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Azure App Service (set these in App Service Configuration) ────────────────
# PORT=8000  # App Service sets this automatically
